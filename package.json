{
  "name": "megit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "以流程白板连接多个仓库的本地 Git 工作台",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "node dist-server/server/index.js --production",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:standards": "node scripts/check-standards.mjs && npm run brand:palette -- --check",
    "brand:palette": "node scripts/render-palette.mjs",
    "format": "prettier --write .",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run check:standards && npm run test && npm run lint && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "express": "^5.3.0",
    "i18next": "^27.1.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
