  "rules": {
    "proportions": "中性色约 80–90%，蓝／青交互色约 8–15%，品牌绿约 2–5%；随内容密度调整，不作为像素硬指标。",
    "contrast": "正文、状态及次级文字至少 4.5:1；关键图形、连线与焦点至少 3:1。",
    "brightColors": "原始亮青和绿色在白底上不用作小号正文；亮色界面使用深色阶。",
    "status": "警告和危险是必要功能扩展，不宣称来自 Logo；仅用于实际状态或操作风险。",
    "runtime": "组件只引用 src/themes.css 的语义 token；此色卡与主题通过测试保持一致。",
    "gradients": "产品界面优先纯色；Logo 保留自身渐变，不把渐变扩散为页面装饰。"
  },
